#!/bin/bash
# Runs src/cal.swift inside "EventKit Helper.app" via `open`, so the Calendar
# and Reminders permissions belong to that app no matter who calls this script.
set -euo pipefail

root="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)"
app="$root/build/EventKit Helper.app"
binary="$app/Contents/MacOS/eventkit-cal"

if [[ ! -x "$binary" || "$root/src/cal.swift" -nt "$binary" ]]; then
  "$root/bin/build-helper" >&2
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
touch "$tmp/out" "$tmp/err"

# `open` starts the app with a clean environment, so settings are passed explicitly.
env_args=(--env "EVENTKIT_STATUS_FILE=$tmp/status" --env "EVENTKIT_PID_FILE=$tmp/pid")
for name in EVENTKIT_CALENDARS EVENTKIT_DEFAULT_CALENDAR EVENTKIT_DEFAULT_LIST; do
  if [[ -n "${!name:-}" ]]; then
    env_args+=(--env "$name=${!name}")
  fi
done

open -n -g "${env_args[@]}" --stdout "$tmp/out" --stderr "$tmp/err" "$app" --args "$@"

# Long enough for the one-time permission prompt.
for _ in $(seq 1 3000); do
  [[ -s "$tmp/status" ]] && break
  sleep 0.1
done
if [[ ! -s "$tmp/status" ]]; then
  pid="$(cat "$tmp/pid" 2>/dev/null || true)"
  command_name="$(ps -p "${pid:-0}" -o comm= 2>/dev/null || true)"
  if [[ "$pid" =~ ^[0-9]+$ && "${command_name##*/}" == eventkit-cal ]] && kill "$pid" 2>/dev/null; then
    echo "EventKit Helper didn't finish within 5 minutes, so it was stopped. If a permission prompt was showing, answer it and run the command again." >&2
  else
    echo "EventKit Helper didn't finish within 5 minutes. It may still be waiting on a permission prompt, and the change may still happen once that prompt is answered, so check before running it again." >&2
  fi
  exit 1
fi

cat "$tmp/out"
cat "$tmp/err" >&2
exit "$(cat "$tmp/status")"

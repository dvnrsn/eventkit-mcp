#!/bin/bash
# Builds "EventKit Helper.app" so macOS grants Calendar and Reminders access to it
# rather than to whichever app (Terminal, Claude) happens to run bin/cal.
set -euo pipefail

root="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)"
app="$root/build/EventKit Helper.app"
# Permissions are tied to the bundle ID; changing it means granting access again.
bundle_id="${EVENTKIT_BUNDLE_ID:-local.eventkit-mcp.helper}"
if [[ ! "$bundle_id" =~ ^[A-Za-z0-9.-]+$ ]]; then
  echo "EVENTKIT_BUNDLE_ID may only contain letters, digits, dots, and hyphens." >&2
  exit 1
fi

# Build beside the old app and swap it in, so a concurrent bin/cal never sees a half-built one.
mkdir -p "$root/build"
staging="$(mktemp -d "$root/build/.staging.XXXXXX")"
trap 'rm -rf "$staging"' EXIT
new="$staging/EventKit Helper.app"
mkdir -p "$new/Contents/MacOS"
swiftc -O "$root/src/cal.swift" -o "$new/Contents/MacOS/eventkit-cal"

cat > "$new/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>$bundle_id</string>
  <key>CFBundleName</key><string>EventKit Helper</string>
  <key>CFBundleExecutable</key><string>eventkit-cal</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>LSUIElement</key><true/>
  <key>NSCalendarsFullAccessUsageDescription</key><string>EventKit Helper reads and changes your calendar events when you, or an assistant you've connected, ask it to.</string>
  <key>NSRemindersFullAccessUsageDescription</key><string>EventKit Helper reads and changes your reminders when you, or an assistant you've connected, ask it to.</string>
</dict>
</plist>
PLIST

codesign --force --sign - "$new"
if [[ -e "$app" ]]; then
  mv "$app" "$staging/old.app"
fi
mv "$new" "$app"
echo "Built $app"
